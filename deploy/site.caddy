# Site served by the server's shared Caddy, which imports this file from the
# repository clone (mounted at /srv/apps/pasantias). Caddy gets the HTTPS
# certificate on its own. Until there is a domain, sslip.io resolves this name
# to the server's IP.
pasantias.165-227-8-179.sslip.io {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy pasantias-api:3000
	}

	# The SPA, built by deploy.sh into deploy/www.
	handle {
		root * /srv/apps/pasantias/deploy/www
		# Files in /assets have a content hash in their name: cache them forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
