# Backend environment in production. Copy to deploy/.env on the server
# (chmod 600); it is never committed.
NODE_ENV=production

# The server's shared PostgreSQL (user and database "pasantias").
DATABASE_URL=postgresql://pasantias:PASSWORD@postgres:5432/pasantias?schema=public

# At least 32 characters: openssl rand -base64 33
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend and API share one origin: Caddy serves the SPA and forwards /api.
# deploy.sh also uses PUBLIC_API_URL as VITE_API_URL when building the frontend.
PUBLIC_API_URL=https://pasantias.165-227-8-179.sslip.io
FRONTEND_URL=https://pasantias.165-227-8-179.sslip.io
CORS_ORIGIN=https://pasantias.165-227-8-179.sslip.io

# Brevo: API key and verified sender.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Internship Portal

# Backblaze B2 (private bucket, S3-compatible API).
S3_BUCKET=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
