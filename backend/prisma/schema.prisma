// Portal de Pasantías y Búsqueda Laboral Estudiantil — database schema.
// ER diagram and data dictionary: docs/database/modelo-de-datos.md
// Equivalent SQL DDL: database/schema.sql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
}

enum OfferType {
  INTERNSHIP
  JOB
}

enum WorkModality {
  ON_SITE
  REMOTE
  HYBRID
}

enum Workload {
  FULL_TIME
  PART_TIME
}

enum OfferStatus {
  OPEN
  CLOSED
  REMOVED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  NEW_MESSAGE
  OFFER_REMOVED
  ACCOUNT_STATUS_CHANGED
}

enum AdminActionType {
  USER_ACTIVATED
  USER_DEACTIVATED
  OFFER_REMOVED
  OFFER_RESTORED
}

// ─────────────────────────────────────────────────────────────
// Users and profiles
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  role            UserRole
  isActive        Boolean   @default(true) @map("is_active")
  // Null until the user confirms the address through the emailed link.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentProfile StudentProfile?
  company        Company?
  sentMessages   Message[]
  notifications  Notification[]
  adminActions   AdminAction[]   @relation("AdminActionAdmin")
  targetedBy     AdminAction[]   @relation("AdminActionTargetUser")
  removedOffers  JobOffer[]      @relation("OfferRemovedBy")

  @@index([role, isActive])
  @@map("users")
}

model StudentProfile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  birthDate    DateTime? @map("birth_date") @db.Date
  career       String    @db.VarChar(150)
  institution  String    @db.VarChar(150)
  studyYear    Int?      @map("study_year") @db.SmallInt
  province     String?   @db.VarChar(100)
  city         String?   @db.VarChar(100)
  bio          String?   @db.Text
  portfolioUrl String?   @map("portfolio_url") @db.VarChar(500)
  cvUrl        String?   @map("cv_url") @db.VarChar(500)
  cvFileName   String?   @map("cv_file_name") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([career])
  @@map("student_profiles")
}

model Company {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  name        String   @db.VarChar(150)
  cuit        String   @unique @db.VarChar(13)
  industry    String?  @db.VarChar(100)
  description String?  @db.Text
  website     String?  @db.VarChar(500)
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  phone       String?  @db.VarChar(30)
  province    String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers JobOffer[]

  @@index([name])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
// Catalogs
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  offers JobOffer[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  offers JobOfferTag[]

  @@map("tags")
}

// ─────────────────────────────────────────────────────────────
// Offers and applications
// ─────────────────────────────────────────────────────────────

model JobOffer {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  categoryId    String       @map("category_id") @db.Uuid
  title         String       @db.VarChar(150)
  description   String       @db.Text
  requirements  String?      @db.Text
  type          OfferType
  modality      WorkModality
  workload      Workload
  province      String?      @db.VarChar(100)
  city          String?      @db.VarChar(100)
  salaryMin     Decimal?     @map("salary_min") @db.Decimal(12, 2)
  salaryMax     Decimal?     @map("salary_max") @db.Decimal(12, 2)
  vacancies     Int          @default(1) @db.SmallInt
  status        OfferStatus  @default(OPEN)
  deadline      DateTime?    @db.Date
  publishedAt   DateTime     @default(now()) @map("published_at") @db.Timestamptz(3)
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(3)
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz(3)
  removedById   String?      @map("removed_by_id") @db.Uuid
  removalReason String?      @map("removal_reason") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  removedBy    User?         @relation("OfferRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  tags         JobOfferTag[]
  applications Application[]
  adminActions AdminAction[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([companyId, status])
  @@index([categoryId])
  @@index([type, modality])
  @@index([province, city])
  @@map("job_offers")
}

model JobOfferTag {
  offerId String @map("offer_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  offer JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tag   Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([offerId, tagId])
  @@index([tagId])
  @@map("job_offer_tags")
}

model Application {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId     String            @map("offer_id") @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  status      ApplicationStatus @default(PENDING)
  coverLetter String?           @map("cover_letter") @db.Text
  cvUrl       String?           @map("cv_url") @db.VarChar(500)
  appliedAt   DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  reviewedAt  DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  offer    JobOffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([offerId, studentId])
  @@index([studentId, status])
  @@index([offerId, status])
  @@map("applications")
}

// ─────────────────────────────────────────────────────────────
// Messaging and notifications
// ─────────────────────────────────────────────────────────────

model Message {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  senderId      String    @map("sender_id") @db.Uuid
  body          String    @db.Text
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String?          @db.Text
  link      String?          @db.VarChar(500)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Administration
// ─────────────────────────────────────────────────────────────

model AdminAction {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId       String          @map("admin_id") @db.Uuid
  action        AdminActionType
  targetUserId  String?         @map("target_user_id") @db.Uuid
  targetOfferId String?         @map("target_offer_id") @db.Uuid
  reason        String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  admin       User      @relation("AdminActionAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  targetUser  User?     @relation("AdminActionTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetOffer JobOffer? @relation(fields: [targetOfferId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetUserId])
  @@index([targetOfferId])
  @@map("admin_actions")
}
