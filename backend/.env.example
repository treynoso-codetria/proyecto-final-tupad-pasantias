# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://usuario:password@localhost:5434/pasantias?schema=public"

# Auth (JWT). Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN="1d"

# Frontend origin(s) allowed by CORS (comma-separated). Defaults to the Vite dev server.
CORS_ORIGIN="http://localhost:5173"

# Base URL of the frontend, used in the links sent by email.
FRONTEND_URL="http://localhost:5173"

# Email (Brevo, https://www.brevo.com). Optional outside production: while
# BREVO_API_KEY is not set, emails are not sent and are written to the server
# log instead, including their links. To send real emails, uncomment both.
# MAIL_FROM_EMAIL must be a verified sender in the Brevo account.
# BREVO_API_KEY=""
# MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Internship Portal"

# File storage (CVs and logos). Optional outside production: while S3_BUCKET
# is not set, files are stored in LOCAL_STORAGE_DIR (backend/uploads) and
# served by the API itself. In production: a private Backblaze B2 bucket, see
# docs/despliegue.md. Uncomment all five to use one.
# S3_BUCKET=""
# S3_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
# S3_REGION="us-east-005"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# LOCAL_STORAGE_DIR="uploads"

# Public URL of this API (without /api), used in the links to the logos.
# Defaults to http://localhost:<PORT>; mandatory in production.
# PUBLIC_API_URL="http://localhost:3000"
